<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E4670"
    tools:context=".samples.BaseSceneActivity">

    <com.eqgis.eqr.layout.SceneLayout
        android:id="@+id/base_scene_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <View
        android:id="@+id/touch_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <Button
        android:id="@+id/btn_capture"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"
        android:text="Capture"
        android:onClick="capture"
        android:textSize="12sp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="100dp"
        android:layout_height="wrap_content"/>

    <Switch
        android:visibility="gone"
        android:id="@+id/switch_primitive"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_capture"
        android:layout_width="wrap_content"
        android:text="Change primitive   "
        android:textColor="#fff"
        android:layout_height="wrap_content"
        tools:ignore="UseSwitchCompatOrMaterialXml" />
</androidx.constraintlayout.widget.ConstraintLayout>
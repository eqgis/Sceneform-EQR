<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Always needed for AR. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_eqr_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_eqr_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">
        <!-- desc- XR 教程允许不支持 ARCore 的设备安装，并在运行时切换到 Camera 3DoF。 -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional"
            tools:replace="android:value" />
        <activity
            android:name=".TutorialTopicActivity"
            android:exported="false" />
        <activity
            android:name=".DeveloperTutorialActivity"
            android:exported="false" />
        <activity
            android:name=".CommonSamplesActivity"
            android:exported="false" />
        <activity
            android:name=".samples.CoordinateConvertActivity"
            android:exported="false" />
        <activity
            android:name=".samples.EarthActivity"
            android:exported="false" />
        <activity
            android:name=".samples.CameraActivity"
            android:exported="false" />
        <activity
            android:name=".samples.VideoActivity"
            android:exported="false"/>
<!--        <activity-->
<!--            android:name=".samples.SlamSceneActivity"-->
<!--            android:exported="false"-->
<!--            android:screenOrientation="landscape" />-->
        <activity
            android:name=".samples.ARSceneActivity"
            android:exported="false" />
        <activity
            android:name=".samples.VRSceneActivity"
            android:exported="false" />
        <activity
            android:name=".samples.VRScene360Activity"
            android:exported="false" />
        <activity
            android:name=".samples.ARScenePlaneActivity"
            android:exported="false" />
        <activity
            android:name=".samples.InteractiveActivity"
            android:exported="false" />
        <activity
            android:name=".samples.BaseSceneActivity"
            android:exported="false" />
        <activity
            android:name=".samples.PlyDataSceneActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.eqgis.eqr.sample.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>

</manifest>

material {
    name : "sceneform_primitive_point",
    shadingModel : unlit,
    blending : transparent,
    parameters : [
        { type : float,     name : pointSize },
        { type : float3,    name : color }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        gl_PointSize = materialParams.pointSize;
    }
}

fragment {

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // gl_PointCoord: [0,1]
        vec2 uv = gl_PointCoord * 2.0 - 1.0; // [-1,1]

        // isotropic Gaussian
        float r2 = dot(uv, uv);

        // σ 控制扩散半径（经验值）
        float sigma = 0.5;
        float weight = exp(-0.5 * r2 / (sigma * sigma));

        // discard 以避免硬边
        if (weight < 0.01) {
            discard;
        }

        vec3 color = materialParams.color;

        material.baseColor.rgb = color * weight;
        material.baseColor.a = weight;
    }
}